{
    "name": "opillion/easy-stack-ntfy-bundle",
    "description": "Symfony bundle for ntfy integration in Easy Stack applications.",
    "type": "symfony-bundle",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "doctrine/data-fixtures": "^2.2",
        "doctrine/dbal": "^4.2",
        "doctrine/doctrine-fixtures-bundle": "^4.3",
        "doctrine/orm": "^3.6",
        "doctrine/persistence": "^4.2",
        "easycorp/easyadmin-bundle": "^5.0",
        "guzzlehttp/guzzle": "7.*",
        "psr/http-message": "^2.0",
        "symfony/config": "^8.0",
        "symfony/console": "^8.0",
        "symfony/dependency-injection": "^8.0",
        "symfony/framework-bundle": "^8.0",
        "symfony/http-foundation": "^8.0",
        "symfony/http-kernel": "^8.0",
        "symfony/routing": "^8.0",
        "symfony/translation": "^8.0",
        "symfony/twig-bundle": "^8.0",
        "symfony/yaml": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Opillion\\EasyStack\\NtfyBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Opillion\\EasyStack\\NtfyBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true
        },
        "sort-packages": true
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.*"
        }
    }
}
